# Editor / tool backup files
*.bak

# Local-only state markers (machine-specific, not shared)
tools/.last-bit-upload
# Content snapshot of the last BIT upload — local operational state, same class as the
# sentinel above, and covered by icloud-backup layer 2 (which is the leg that sees
# gitignored files). Tradeoff stated rather than hidden: unlike bandsintown-upload.csv
# this is NOT regenerable — it records a past act. Losing it degrades the next run to
# UNKNOWN, which is safe-but-manual (check the profile), never silently wrong.
tools/.bit-last-uploaded.csv

# Wrangler local state (auth cache, build artifacts) — never commit
.wrangler/

# Show-reminder runtime state + rendered reports. Never committed: the state file
# is machine-local bookkeeping, and a rendered reminder is a SNAPSHOT of a forecast
# that decays -- the same reason forecasts are not persisted into data/.
tools/.reminder-state.json
.reminders/
__pycache__/

# derived by tools/bit-delta.py — regenerable, never the source
bandsintown-delta.csv
